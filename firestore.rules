rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // System Users & Admin Approval Collection
    match /system_users/{userId} {
      allow read, write: if true;
    }

    // Shop Workspace & Settings
    match /shops/{shopId} {
      allow read, write: if true;

      // Barbers Subcollection
      match /barbers/{barberId} {
        allow read, write: if true;
      }

      // Products Subcollection
      match /products/{productId} {
        allow read, write: if true;
      }

      // Bills / Sales Subcollection
      match /bills/{billId} {
        allow read, write: if true;
      }

      // Expenses Subcollection
      match /expenses/{expenseId} {
        allow read, write: if true;
      }

      // Queues Subcollection
      match /queues/{queueId} {
        allow read, write: if true;
      }
    }
  }
}

